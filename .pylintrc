[MASTER]
ignore=manage.py,create_db.py,.venv
ignore-patterns=.*\.venv.*|0001_initial|main.migrations
load-plugins=pylint_django
django-settings-module=USAZD.settings
recursive=y
jobs=1
limit-inference-results=100

[MESSAGES CONTROL]
disable=E1101,C0103,C0114,W0401,W0406,W0614,C0415,R0914,R0913,R0917,W0718,W1203,W1309,R1705,C0301,E0102,W0612,R1731,R0911,E5142,W0621,R0912, R1702, C1803, C0116